# Copy to .env for local development. Never commit .env.

# PostgreSQL connection string. Leave empty locally to use a SQLite file (data/app.db).
# On Vercel this is filled automatically when you connect a Neon database.
DATABASE_URL=

# Secret used to sign login sessions (at least 32 random characters).
# Optional: if empty, a random secret is generated once and stored in the database.
JWT_SECRET=

# Optional: SerpApi key for real-time Google Flights fares (https://serpapi.com, free plan 250 searches/month).
# Without it, the site shows direct search links to Trip.com / Google Flights / Skyscanner / Traveloka instead.
SERPAPI_KEY=

PORT=3000
